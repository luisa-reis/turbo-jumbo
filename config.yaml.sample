# yaml-language-server: $schema=./config.schema.json
#
# Sample configuration. Copy to config.yaml and edit to match your setup:
#
#   cp config.yaml.sample config.yaml
#
# The app reads ./config.yaml from the working directory by default. Set the
# CONFIG_PATH environment variable to load it from somewhere else.

# How often, in seconds, to poll each remote peer for reachability and model
# changes. Optional; defaults to 5.
peer_check_interval: 5

# The machines that share models, including this one. The local peer is the one
# whose address host matches this machine's own IP; base_path and
# cold_storage_path are read from its entry. Remote peers only need a name and
# address. Leave base_path out (or this machine out of the list entirely) to
# run a viewer: a UI that shows and manages the peers' models but holds none
# itself.
peers:
  # This machine.
  - name: this-machine
    address: 192.168.1.10:3000

    # URL-safe id for this peer: the segment naming it in its tab path
    # (/this-machine) and in the API endpoints that address it
    # (/api/v1/peers/this-machine/…). Lowercase letters, digits and single
    # hyphens. Optional; defaults to the name lowercased with runs of anything
    # else turned into hyphens. Set it when the name is not plain ASCII — the
    # default mangles "Zürich" into "z-rich" and leaves a name like "東京"
    # with no slug at all, which the app refuses to start with. Two peers may
    # not share a slug, and all, cold-storage, download and api are reserved.
    # slug: this-machine

    # Directory containing the model subdirectories. Local models live in
    # <base_path>/turbo-jumbo and Lemonade's own model cache in
    # <base_path>/lemonade (override the names below). Optional: without it
    # this machine is a viewer that holds no models.
    base_path: /mnt/models

    # Cold-storage (slow, archival) model directory. Optional: without it this
    # machine has no Cold Storage tab and nothing offers it as a destination.
    cold_storage_path: /mnt/cold-storage

    # Subdirectory under base_path holding the local (turbo-jumbo) models.
    # Optional. Default: turbo-jumbo
    # turbo_jumbo_subdir: turbo-jumbo

    # Subdirectory under base_path holding Lemonade's model cache. Optional.
    # Default: lemonade
    # lemonade_subdir: lemonade

    # API base URL of the Lemonade server associated with this peer. Enables
    # browsing and downloading the models only that server can fetch (the
    # FLM/NPU models it discovers at runtime). Optional.
    # lemonade_url: http://192.0.2.10:13305/api/v1
    #
    # FLM (NPU) models that server pulls itself go to its `flm` binary's own
    # store, ~/.config/flm/models there by default. Set
    # FLM_MODEL_PATH=<base_path>/lemonade/flm in that server's environment to
    # keep them on the shared disk (the weights land under flm/models/).

    # Its API key, when that server was started with LEMONADE_API_KEY set (it
    # then answers 401 to everything else). Sent as a Bearer token and never
    # shown to browsers. Optional.
    # lemonade_api_key: change-me

  # A remote peer — only name and address are needed.
  - name: my-server
    address: 192.168.1.11:3000

  # A peer served by a standalone storage agent (bun run agent on that
  # machine) instead of the full app: storage operations and transfers
  # go to the agent, authenticated with its token (agent.yaml.sample).
  # - name: shelf
  #   address: 192.168.1.13:3000
  #   agent_address: 192.168.1.13:3900
  #   agent_token: change-me
  #   # Where shelf's models root is mounted on this machine (NFS or similar).
  #   # With it, Hugging Face downloads to shelf run `hf` here and write
  #   # straight into the mount rather than on shelf itself.
  #   models_mount: /mnt/models-shelf/turbo-jumbo

  # A peer whose name needs a slug spelled out, since one derived from it
  # would be unusable.
  - name: Zürich
    address: 192.168.1.12:3000
    slug: zurich
