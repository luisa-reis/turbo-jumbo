# Configuration for the storage agent (tj-agent). Copy to agent.yaml next to
# where the agent runs, or point TJ_AGENT_CONFIG at it.
#
# The agent serves the storage protocol for this machine's model disks and
# knows nothing else — no peer list, no UI. Build it with
# `cargo build --release` in agent/ (the binary lands at
# agent/target/release/tj-agent; `bun run agent` wraps cargo run for dev).
# On the control host, point the matching peer entry at it with
# agent_address/agent_token in config.yaml. Downloads shell out to the `hf`
# CLI, so a downloading agent's environment needs hf on PATH plus HF_TOKEN /
# Xet setup — see deploy/tj-agent.service.

# Port to listen on. (0 picks a free port and announces it on the startup
# line — how the conformance tests run the binary.)
port: 3900

# Bearer token every request must present. Optional, but run without one only
# on a loopback experiment — anyone who can reach the port can move files.
token: change-me

# The directories behind the storage roots. Each optional; at least one.
# These are the same directories the full app derived from base_path:
# models   = <base_path>/turbo-jumbo
# cold     = <cold_storage_path>
# lemonade = <base_path>/lemonade
roots:
  models: /mnt/models/turbo-jumbo
  cold: /mnt/cold-storage
  lemonade: /mnt/models/lemonade
