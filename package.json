{
  "name": "turbo-jumbo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:watch": "node_modules/@typescript/native/bin/tsc --noEmit --watch",
    "test": "bun test",
    "docker:build": "bin/docker-build.sh",
    "tj": "bun run cli/index.ts",
    "agent": "cargo run --release --manifest-path agent/Cargo.toml"
  },
  "dependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "0.19.2",
    "@toon-format/toon": "^4.4.0",
    "ajv": "^8.20.0",
    "js-yaml": "5.5.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@stylexswc/nextjs-plugin": "0.20.1",
    "@stylexswc/postcss-plugin": "0.20.1",
    "@stylexswc/swc-plugin": "0.5.1",
    "@types/bun": "^1.4.5",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "autoprefixer": "^10.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@swc/core",
    "sharp",
    "unrs-resolver"
  ],
  "bin": {
    "tj": "./cli/index.ts"
  }
}
