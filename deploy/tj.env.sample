# Per-host environment for the turbo-jumbo user unit: ~/tj/tj.env on the
# target, one KEY=value per line, read before the release's own release.env.
# Nothing is required; a viewer (no base_path) typically has no tj.env at all.

# A storage peer — one with a base_path — spawns the `hf` CLI to download.
# Everything hf needs is set here, nowhere in the unit:

# the CLI from its user-local install (the installer's default location)
#PATH=/home/<account>/.local/bin:/usr/local/bin:/usr/bin:/bin

# Xet-accelerated transfers
#HF_XET_HIGH_PERFORMANCE=1

# the token for gated or private repos: a file (mode 600), or the value
#HF_TOKEN_FILE=/home/<account>/hf_token.txt
#HF_TOKEN=hf_…

# Other overrides of the unit's defaults.
#PORT=3000
#CONFIG_PATH=/home/<account>/tj/config.yaml
