# Settings for bin/deploy.sh. Copy into .env at the repo root (gitignored) —
# the same file bin/watch-deploy.sh used to read — or point the script at
# another file with ENV_FILE=/path/to/env. Hostnames stay out of the repo.

# Where to deploy, as ssh spells it (required).
DEPLOY_HOST=user@host

# Directory under the target account's home holding releases/, current,
# config.yaml and tj.env (default: tj). Must match the unit's paths.
#DEPLOY_DIR=tj

# Port the health check polls after the restart (default: 3000; change it
# together with PORT in ~/<dir>/tj.env on the target).
#DEPLOY_PORT=3000

# Releases kept on the target, the running one included (default: 3).
#DEPLOY_KEEP=3
