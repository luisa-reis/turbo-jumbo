# Settings for bin/deploy.sh. Copy into .env at the repo root (gitignored) —
# the same file bin/watch-deploy.sh used to read — or point the script at
# another file with ENV_FILE=/path/to/env. Hostnames stay out of the repo.
#
# A plain `bin/deploy.sh` deploys whatever is configured here: the Next app to
# DEPLOY_HOST, and the storage agent to each of AGENT_HOSTS. Restrict a run
# with --app or --agents. At least one of the two must be set.

# ---- the Next app (bin/deploy.sh --app) ----

# Where to deploy the app, as ssh spells it. Leave unset to deploy only agents.
DEPLOY_HOST=user@host

# Directory under the target account's home holding releases/, current,
# config.yaml and tj.env (default: tj). Must match the unit's paths.
#DEPLOY_DIR=tj

# Port the health check polls after the restart (default: 3000; change it
# together with PORT in ~/<dir>/tj.env on the target).
#DEPLOY_PORT=3000

# Releases kept on the target, the running one included (default: 3).
#DEPLOY_KEEP=3

# ---- the storage agents (bin/deploy.sh --agents) ----

# The storage boxes to run tj-agent on, space-separated, as ssh spells them.
# One agent per box; leave unset to deploy only the app.
#AGENT_HOSTS="user@box1 user@box2"

# Directory under each agent account's home holding releases/, current,
# agent.yaml and agent.env (default: tj-agent). Must match the unit's paths.
#AGENT_DIR=tj-agent

# Port the agent health check polls (default: 3900; must match `port:` in each
# agent's agent.yaml).
#AGENT_PORT=3900

# Agent releases kept on each box, the running one included (default: same as
# DEPLOY_KEEP).
#AGENT_KEEP=3

# Rust target for the agent binary. Default is a fully static musl build, so one
# binary runs on any box regardless of its libc — needs `rustup target add
# x86_64-unknown-linux-musl` once. Set empty to build for the build host's own
# target instead (only safe when every box's glibc is at least the build host's).
#AGENT_TARGET=x86_64-unknown-linux-musl
